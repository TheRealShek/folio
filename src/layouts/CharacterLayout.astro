---
import PrevNext from "../components/PrevNext.astro";
import RatingBadge from "../components/RatingBadge.astro";
import TagPill from "../components/TagPill.astro";
import BaseLayout from "./BaseLayout.astro";

interface CharacterLink {
  id: string;
  body: string;
  data: {
    name?: string;
  };
}

interface Props {
  title: string;
  description?: string;
  name: string;
  subtitle?: string;
  series?: string;
  rating?: number;
  tags?: string[];
  spoilers?: boolean;
  prev?: CharacterLink;
  next?: CharacterLink;
}

const { title, description, name, subtitle, series, rating, tags, spoilers, prev, next } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="character-hero">
    <a
      href="/"
      class="back-link"
      aria-label="Back to archive"
    >
      <span aria-hidden="true">&larr;</span>
      <span>Back to Archive</span>
    </a>
    <h1 class="character-name">
      {name}
    </h1>
    {subtitle && (
      <p class="character-subtitle">{subtitle}</p>
    )}
    {series && (
      <p class="character-series">{series}</p>
    )}
  </section>

  <section class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="divider"></div>

    {(tags?.length || rating !== undefined) && (
      <>
        <div class="flex flex-col gap-4 py-5 md:flex-row md:items-start md:justify-between">
          {tags?.length ? (
            <div class="flex flex-wrap gap-x-5 gap-y-1">
              {tags.map((tag) => <TagPill label={tag} />)}
            </div>
          ) : (
            <div></div>
          )}

          {rating !== undefined && <RatingBadge rating={rating} />}
        </div>
        <div class="divider"></div>
      </>
    )}

    <div class="article-container">
      {spoilers && (
        <p class="spoiler-warning">
          Spoiler warning: this analysis discusses major story beats.
        </p>
      )}

      <article class="prose">
        <slot />
      </article>
    </div>

    <div class="divider"></div>
    <PrevNext prev={prev} next={next} />

    {/* Return to Archive — secondary navigation */}
    <div class="archive-return">
      <a href="/" class="archive-return-link">
        <span aria-hidden="true">◈</span>
        <span>Return to Archive</span>
      </a>
    </div>
  </section>

  <!-- Reading progress bar -->
  <div class="progress-bar" aria-hidden="true">
    <div class="progress-bar__fill" id="progress-fill"></div>
  </div>

  <!-- Back to top -->
  <button class="back-to-top" id="back-to-top" aria-label="Back to top">&uarr;</button>

  <script is:inline>
    const initCharacterPage = () => {
      const fill = document.getElementById("progress-fill");
      const btn = document.getElementById("back-to-top");
      if (!fill || !btn) return;

      const update = () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (docHeight > 0) {
          fill.style.transform = `scaleX(${Math.min(scrollTop / docHeight, 1)})`;
        }
        btn.classList.toggle("visible", scrollTop > window.innerHeight);
      };

      window.addEventListener("scroll", update, { passive: true });
      update();

      btn.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    };

    initCharacterPage();
    document.addEventListener("astro:page-load", initCharacterPage);
  </script>
</BaseLayout>
