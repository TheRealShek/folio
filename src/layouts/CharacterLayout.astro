---
import { Image } from "astro:assets";
import PrevNext from "../components/PrevNext.astro";
import RatingBadge from "../components/RatingBadge.astro";
import TagPill from "../components/TagPill.astro";
import BaseLayout from "./BaseLayout.astro";

interface CharacterLink {
  id: string;
  body: string;
  data: {
    name?: string;
  };
}

interface Props {
  title: string;
  description?: string;
  name: string;
  series?: string;
  rating?: number;
  tags?: string[];
  cover?: string;
  spoilers?: boolean;
  prev?: CharacterLink;
  next?: CharacterLink;
}

const { title, description, name, series, rating, tags, cover, spoilers, prev, next } = Astro.props;
---

<BaseLayout title={title} description={description}>
  {cover ? (
    <section class="relative">
      <div class="relative h-[50vh] min-h-[24rem] overflow-hidden md:h-[60vh]">
        <Image
          src={cover}
          alt={name}
          width={1600}
          height={1200}
          class="h-full w-full object-cover"
        />
        <div class="absolute inset-x-0 bottom-0 h-[40%] bg-linear-to-t from-[var(--bg-base)] to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 mx-auto max-w-6xl px-6 pb-10 lg:px-8">
          <a
            href="/"
            class="mb-6 hidden w-fit items-center gap-2 text-xs uppercase tracking-[0.14em] text-[var(--text-muted)] transition-colors duration-200 hover:text-[var(--text-primary)] md:inline-flex"
            style="font-family: var(--font-ui);"
            aria-label="Back to archive"
          >
            <span aria-hidden="true">&larr;</span>
            <span>Back</span>
          </a>
          <h1
            class="max-w-[12ch] text-[clamp(3rem,8vw,6rem)] leading-none text-[var(--text-primary)]"
            style="font-family: var(--font-display);"
          >
            {name}
          </h1>
          {series && (
            <p
              class="mt-4 text-sm uppercase tracking-[0.18em] text-[var(--text-muted)]"
              style="font-family: var(--font-ui);"
            >
              {series}
            </p>
          )}
        </div>
      </div>
    </section>
  ) : (
    <section class="mx-auto max-w-6xl px-6 pb-8 pt-12 lg:px-8 lg:pt-16">
      <a
        href="/"
        class="mb-6 hidden w-fit items-center gap-2 text-xs uppercase tracking-[0.14em] text-[var(--text-muted)] transition-colors duration-200 hover:text-[var(--text-primary)] md:inline-flex"
        style="font-family: var(--font-ui);"
        aria-label="Back to archive"
      >
        <span aria-hidden="true">&larr;</span>
        <span>Back</span>
      </a>
      <h1
        class="max-w-[12ch] text-[clamp(3rem,8vw,6rem)] leading-none text-[var(--text-primary)]"
        style="font-family: var(--font-display);"
      >
        {name}
      </h1>
      {series && (
        <p
          class="mt-4 text-sm uppercase tracking-[0.18em] text-[var(--text-muted)]"
          style="font-family: var(--font-ui);"
        >
          {series}
        </p>
      )}
    </section>
  )}

  <section class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="divider"></div>

    {(tags?.length || rating !== undefined) && (
      <>
        <div class="flex flex-col gap-4 py-5 md:flex-row md:items-start md:justify-between">
          {tags?.length ? (
            <div class="flex flex-wrap gap-x-5 gap-y-1">
              {tags.map((tag) => <TagPill label={tag} />)}
            </div>
          ) : (
            <div></div>
          )}

          {rating !== undefined && <RatingBadge rating={rating} />}
        </div>
        <div class="divider"></div>
      </>
    )}

    <div class="px-6 py-10 md:px-0 md:py-14">
      {spoilers && (
        <p
          class="mx-auto mb-6 max-w-[680px] text-sm uppercase tracking-[0.14em] text-[var(--text-muted)]"
          style="font-family: var(--font-ui);"
        >
          Spoiler warning: this analysis discusses major story beats.
        </p>
      )}

      <article class="prose">
        <slot />
      </article>
    </div>

    <div class="divider"></div>
    <PrevNext prev={prev} next={next} />
  </section>

  <!-- Reading progress bar -->
  <div class="progress-bar" aria-hidden="true">
    <div class="progress-bar__fill" id="progress-fill"></div>
  </div>

  <!-- Back to top -->
  <button class="back-to-top" id="back-to-top" aria-label="Back to top">&uarr;</button>

  <script is:inline>
    const initCharacterPage = () => {
      const fill = document.getElementById("progress-fill");
      const btn = document.getElementById("back-to-top");
      if (!fill || !btn) return;

      const update = () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (docHeight > 0) {
          fill.style.transform = `scaleX(${Math.min(scrollTop / docHeight, 1)})`;
        }
        btn.classList.toggle("visible", scrollTop > window.innerHeight);
      };

      window.addEventListener("scroll", update, { passive: true });
      update();

      btn.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    };

    initCharacterPage();
    document.addEventListener("astro:page-load", initCharacterPage);
  </script>
</BaseLayout>
