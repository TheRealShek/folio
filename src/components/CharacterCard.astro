---
import { Image } from "astro:assets";
import RatingBadge from "./RatingBadge.astro";

interface Props {
  href: string;
  name: string;
  series?: string;
  rating?: number;
  cover?: string;
}

const { href, name, series, rating, cover } = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col border border-[var(--border)] bg-[var(--bg-surface)] transition duration-200 ease-in-out hover:-translate-y-[3px] hover:border-[var(--accent-dim)] hover:bg-[var(--bg-elevated)]"
>
  {cover && (
    <div class="aspect-[3/4] overflow-hidden border-b border-[var(--border)] bg-[var(--bg-elevated)]">
      <Image
        src={cover}
        alt={name}
        width={720}
        height={960}
        class="h-full w-full object-cover transition duration-200 ease-in-out group-hover:scale-[1.02]"
      />
    </div>
  )}

  <div class:list={["flex flex-1 flex-col justify-end px-5 py-5 sm:px-6", !cover && "min-h-[16rem]"]}>
    <h2
      class:list={[
        "text-[var(--text-primary)] leading-none",
        cover ? "text-[2rem]" : "max-w-[10ch] text-[clamp(2.6rem,7vw,4rem)]"
      ]}
      style="font-family: var(--font-display);"
    >
      {name}
    </h2>

    {(series || rating !== undefined) && (
      <div class="mt-4 flex items-end justify-between gap-4">
        {series && (
          <p
            class="m-0 text-sm uppercase tracking-[0.16em] text-[var(--text-muted)]"
            style="font-family: var(--font-ui);"
          >
            {series}
          </p>
        )}

        {rating !== undefined && <RatingBadge rating={rating} />}
      </div>
    )}
  </div>
</a>
