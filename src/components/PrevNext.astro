---
import { getCharacterName, getCharacterSlug } from "../utils/characters";

interface CharacterLink {
  id: string;
  body: string;
  data: {
    name?: string;
  };
}

interface Props {
  prev?: CharacterLink;
  next?: CharacterLink;
}

const { prev, next } = Astro.props;
---

<nav class="prevnext">
  <div class="prevnext-col">
    {prev && (
      <a
        href={`/characters/${getCharacterSlug(prev)}/`}
        class="prevnext-link"
      >
        <span class="prevnext-label">Previous</span>
        <span class="prevnext-name">&larr; {getCharacterName(prev)}</span>
      </a>
    )}
  </div>

  <div class="prevnext-divider"></div>

  <div class="prevnext-col prevnext-col--right">
    {next && (
      <a
        href={`/characters/${getCharacterSlug(next)}/`}
        class="prevnext-link"
      >
        <span class="prevnext-label">Next</span>
        <span class="prevnext-name">{getCharacterName(next)} &rarr;</span>
      </a>
    )}
  </div>
</nav>
