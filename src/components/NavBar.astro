---
---

<header class="sticky top-0 z-50">
  <div
    class="relative"
    style="background: color-mix(in srgb, var(--bg-base) 82%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid color-mix(in srgb, var(--divider) 86%, transparent);"
  >
    <div class="mx-auto flex max-w-6xl items-center px-6 py-3 lg:px-8">
      <a
        href="/"
        class="group inline-flex items-center gap-3 py-1 text-[2.1rem] leading-[0.94] text-[var(--text-primary)] transition-colors duration-200 hover:text-[var(--text-primary)]"
        style="font-family: var(--font-display); letter-spacing: 0.01em;"
        aria-label="Folio home"
      >
        <img
          src="/logo.png"
          alt=""
          class="h-11 w-auto transition-opacity duration-200 group-hover:opacity-80"
          aria-hidden="true"
        />
        <span class="relative inline-flex items-center">
          Folio
        </span>
      </a>
    </div>
  </div>
</header>
