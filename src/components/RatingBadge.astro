---
interface Props {
  rating: number;
}

const { rating } = Astro.props;
const formattedRating = Number.isInteger(rating) ? rating.toFixed(0) : rating.toFixed(1);
---

<span
  class="inline-flex items-center py-2 text-sm text-[var(--accent)]"
  style="font-family: var(--font-ui);"
>
  {formattedRating}/10
</span>
