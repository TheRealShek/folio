---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CharacterCard from "../components/CharacterCard.astro";
import { getCharacterName, getCharacterSlug } from "../utils/characters";

const characters = await getCollection("characters");

/* Shuffle characters on every render (Fisher-Yates) */
const shuffled = [...characters];
for (let i = shuffled.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
}

/* Assign tiers purely by shuffled position */
type Tier = "hero" | "emphasis" | "subdued";
const tierOf = (i: number, total: number): Tier => {
  if (i < 2) return "hero";
  if (i < Math.ceil(total * 0.5)) return "emphasis";
  return "subdued";
};

const entries = shuffled.map((entry, i) => ({
  entry,
  tier: tierOf(i, shuffled.length),
  name: getCharacterName(entry),
  slug: getCharacterSlug(entry),
  index: String(i + 1).padStart(2, "0"),
}));

/* Partition into Showcase (hero + emphasis) and Index (subdued) */
const showcase = entries.filter((e) => e.tier !== "subdued");
const index = entries.filter((e) => e.tier === "subdued");

/* Filters */
const types = [...new Set(characters.map((c) => c.data.type).filter(Boolean))].sort() as string[];
const showFilters = types.length > 1;
const filters = ["all", ...types];
---

<BaseLayout title="Folio" description="Personal character analysis and long-form reading.">
  <section class="toc-section">
    {showFilters && (
      <div class="toc-filters">
        <div class="filter-track" aria-label="Character type filters">
          {filters.map((filter, i) => (
            <button
              type="button"
              class:list={["filter-tab", i === 0 && "active"]}
              data-filter={filter}
            >
              {filter}
            </button>
          ))}
        </div>
      </div>
    )}

    {/* ── Zone 1: Bento Showcase ── */}
    <div class="showcase-grid" role="list">
      {showcase.map((item, i) => (
        <div
          class="showcase-card"
          data-tier={item.tier}
          data-character-type={item.entry.data.type ?? "all"}
          style={`--entry-index: ${i};`}
          role="listitem"
        >
          <CharacterCard
            href={`/characters/${item.slug}/`}
            name={item.name}
            subtitle={item.entry.data.subtitle}
            series={item.entry.data.series}
            rating={item.entry.data.rating}
            cover={item.entry.data.cover}
            domain={item.entry.data.domain}
            era={item.entry.data.era}
            tier={item.tier}
            emphasis={item.tier === "hero" ? "anchor" : "secondary"}
            spanHint={item.tier === "hero" ? 2 : 1}
          />
        </div>
      ))}
    </div>

    {/* ── Section Divider ── */}
    {index.length > 0 && (
      <div class="index-divider" aria-hidden="true">
        <span>Full Index</span>
      </div>
    )}

    {/* ── Zone 2: Master Index ── */}
    {index.length > 0 && (
      <div class="master-index" role="list">
        {index.map((item, i) => (
          <a
            href={`/characters/${item.slug}/`}
            class="toc-entry"
            data-tier={item.tier}
            data-character-type={item.entry.data.type ?? "all"}
            style={`--entry-index: ${showcase.length + i};`}
            role="listitem"
          >
            <span class="toc-index" aria-hidden="true">{item.index}</span>
            <div class="toc-content">
              <span class="toc-name">{item.name}</span>
              {(item.entry.data.series || item.entry.data.rating !== undefined) && (
                <span class="toc-subtext">
                  {item.entry.data.series}
                  {item.entry.data.series && item.entry.data.rating !== undefined && " · "}
                  {item.entry.data.rating !== undefined && `${item.entry.data.rating}/10`}
                </span>
              )}
            </div>
          </a>
        ))}
      </div>
    )}
  </section>

  {showFilters && (
    <script is:inline>
      const setupFilters = () => {
        const tabs = Array.from(document.querySelectorAll(".filter-tab"));
        const showcaseCards = Array.from(document.querySelectorAll(".showcase-card"));
        const indexEntries = Array.from(document.querySelectorAll(".master-index .toc-entry"));
        const allItems = [...showcaseCards, ...indexEntries];
        if (!tabs.length || !allItems.length) return;

        const apply = (active) => {
          tabs.forEach((t) => {
            t.classList.toggle("active", t.dataset.filter === active);
          });
          allItems.forEach((e) => {
            const match = active === "all" || e.dataset.characterType === active;
            e.toggleAttribute("hidden", !match);
          });
        };

        apply("all");
        tabs.forEach((t) => t.addEventListener("click", () => apply(t.dataset.filter ?? "all")));
      };

      setupFilters();
      document.addEventListener("astro:page-load", setupFilters);
    </script>
  )}
</BaseLayout>
